{
  "name": "atten-x-recovery-work-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "setup": "node --import tsx src/cli.ts setup",
    "reset": "node --import tsx src/cli.ts reset",
    "scenario": "node --import tsx src/cli.ts scenario",
    "verify:starter": "node --import tsx src/cli.ts verify:starter",
    "verify:assignment": "node --import tsx src/cli.ts verify:assignment",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/runtime.test.ts",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
